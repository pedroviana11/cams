# Template do nginx (envsubst na subida): painel em PAINEL_PORTA, Frigate (com login) em FRIGATE_PORTA.
# Container usa a rede do host, então 127.0.0.1 é a máquina.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen ${PAINEL_PORTA};
    server_name _;
    root /usr/share/nginx/html;

    location ~ ^/(api|vod|clips|exports|live)/ {
        proxy_pass http://127.0.0.1:${FRIGATE_PORTA};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # streams ao vivo (MJPEG/MSE) e downloads grandes não podem ser bufferizados nem cortados
        proxy_buffering off;
        proxy_read_timeout 1h;
        client_max_body_size 10m;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
