# Copie para .env (ou rode ./instalar.sh, que pergunta tudo)

# Câmera Yoosee: IP na rede e senha do dispositivo (URL-encode: # -> %23, @ -> %40)
CAMERA_SALA_IP=192.168.15.12
CAMERA_SENHA=

# Pasta das gravações (~40 GB para 5 dias); precisa existir antes de subir
GRAVACOES=/srv/cams/gravacoes

# Login do painel (8090) e da UI do Frigate (8091)
PAINEL_USUARIO=pedro
PAINEL_SENHA=
